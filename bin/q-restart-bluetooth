#!/usr/bin/env bash
# restart-bluetooth — restart the bluetooth stack.
# NOTE: this machine currently has no bluez userspace installed, so the unit
# check below will tell you. Once `pacman -S bluez bluez-utils` is done and the
# service is enabled, this script just works.
set -u

if ! systemctl list-unit-files bluetooth.service --no-pager 2>/dev/null | grep -q "^bluetooth.service"; then
    echo "bluetooth.service not found — is bluez installed?" >&2
    echo "install with: sudo pacman -S bluez bluez-utils && sudo systemctl enable --now bluetooth" >&2
    exit 1
fi

sudo systemctl restart bluetooth.service
sleep 1
if systemctl is-active --quiet bluetooth.service; then
    echo "bluetooth restarted ✓"
else
    echo "bluetooth failed to start:" >&2
    systemctl status bluetooth.service --no-pager -n 5 >&2
    exit 1
fi
