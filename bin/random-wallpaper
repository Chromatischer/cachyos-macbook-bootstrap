#!/usr/bin/env bash
set -Eeuo pipefail

directory="${FRIEND_WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
[[ -d "$directory" ]] || {
  printf 'Wallpaper directory does not exist: %s\n' "$directory" >&2
  exit 1
}

mapfile -d '' wallpapers < <(
  find "$directory" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    -print0
)
((${#wallpapers[@]})) || {
  printf 'No wallpapers found in %s\n' "$directory" >&2
  exit 1
}

wallpaper="${wallpapers[RANDOM % ${#wallpapers[@]}]}"
ln -sfn -- "$wallpaper" "$directory/current"
export FRIEND_WALLPAPER="$wallpaper"
exec friend-wallpaper
