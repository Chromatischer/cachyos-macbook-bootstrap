{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/rice/rice.txt",
    "color": { "1": "blue" },
    "padding": { "top": 2, "right": 5 }
  },
  "display": { "separator": "  " },
  "modules": [
    "break",
    { "type": "title", "keyColor": "magenta" },
    { "type": "os", "key": " OS", "keyColor": "blue" },
    { "type": "host", "key": " Host", "keyColor": "blue" },
    { "type": "kernel", "key": " Kernel", "keyColor": "blue" },
    { "type": "wm", "key": " WM", "keyColor": "blue" },
    { "type": "terminal", "key": " Terminal", "keyColor": "blue" },
    { "type": "cpu", "key": " CPU", "keyColor": "mauve" },
    { "type": "gpu", "key": "󰢮 GPU", "keyColor": "mauve" },
    { "type": "memory", "key": " Memory", "keyColor": "mauve" },
    { "type": "disk", "key": "󰋊 Disk", "keyColor": "mauve" },
    { "type": "battery", "key": "󰁹 Battery", "keyColor": "green" },
    { "type": "uptime", "key": "󱫐 Uptime", "keyColor": "green" },
    "break"
  ]
}

