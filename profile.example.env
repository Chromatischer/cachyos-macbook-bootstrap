# Copy this file to profile.env. Do not put passwords, tokens, or private keys here.

# Obtain this in macOS with: system_profiler SPHardwareDataType | grep 'Model Identifier'
MAC_MODEL="UNKNOWN"

# auto, yes, or no. Use yes only after confirming the machine has an Apple T2 chip.
HAS_T2="auto"

# XKB layout and options. Examples: us, de, gb. Set options to an empty string
# if Caps Lock should remain Caps Lock instead of acting as Compose.
KEYBOARD_LAYOUT="us"
KEYBOARD_OPTIONS="compose:caps"

# Common installation groups.
INSTALL_DESKTOP=1
INSTALL_DEVELOPMENT=1
INSTALL_OPTIONAL_APPS=0
INSTALL_AUR_APPS=0
INSTALL_CODEX=1
INSTALL_CODEX_CONFIG=1
SET_ZSH_AS_LOGIN_SHELL=1

# The generic Hyprland Lua config uses automatic output selection. Set this after
# the first boot only if automatic scaling is not comfortable.
INTERNAL_DISPLAY_SCALE="auto"
